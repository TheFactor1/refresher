<?xml version="1.0" encoding="utf-8"?>
<!--
  Refresher Home, "cinema": the selected app's art fills the screen behind everything. A greeting, what's
  playing, Clean up and Settings on top; the clock inside a halo that shows free memory, with the processor
  and storage either side; a dark glass dock of favourites with All apps. One screen: nothing scrolls.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/homeRoot"
        style="@style/Screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/netLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/netVpn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/nowPlaying"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_music"
                    android:tint="@color/home_chip_text" />

                <TextView
                    android:id="@+id/nowPlayingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:maxWidth="300dp"
                    android:maxLines="1"
                    android:textColor="@color/home_chip_text"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/nowPlayingIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/text_primary"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/text_on_focus" />
            </LinearLayout>

            <TextView
                android:id="@+id/cleanChip"
                style="@style/GlassChip"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_sparkle"
                android:text="@string/home_clean" />

            <TextView
                android:id="@+id/settingsChip"
                style="@style/GlassChip"
                android:layout_width="40dp"
                android:contentDescription="@string/home_settings"
                android:drawableStart="@drawable/ic_gear"
                android:paddingStart="11dp"
                android:paddingEnd="11dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <include
                android:id="@+id/cpuStat"
                layout="@layout/view_home_stat" />

            <com.thefactor1.taskskiller.ui.HaloView
                android:id="@+id/halo"
                android:layout_width="@dimen/home_halo"
                android:layout_height="@dimen/home_halo"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:contentDescription="@string/system_title">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/homeDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:maxLines="1"
                        android:textColor="#FFC9D1DE"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="96sp" />

                    <TextView
                        android:id="@+id/haloText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.thefactor1.taskskiller.ui.HaloView>

            <include
                android:id="@+id/diskStat"
                layout="@layout/view_home_stat" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_glass_dark"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <LinearLayout
                android:id="@+id/dockApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <View
                android:id="@+id/dockDivider"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="#1FFFFFFF" />

            <ImageView
                android:id="@+id/allApps"
                android:layout_width="61dp"
                android:layout_height="61dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_glass_tile"
                android:clickable="true"
                android:contentDescription="@string/home_all_apps"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_apps"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/dockCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFC9D1DE"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
