<?xml version="1.0" encoding="utf-8"?>
<!-- One gauge on the System screen: name and value, an 8dp meter, and a plain-words line under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meterLabel"
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/meterValue"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/meterBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/space_s"
        android:max="100"
        android:progressDrawable="@drawable/meter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/meterHint"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp" />
</LinearLayout>
