<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Crumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crumb_home_settings" />

    <TextView
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:accessibilityHeading="true"
        android:text="@string/home_settings_title" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settingsRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/tilesRow"
                layout="@layout/row_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
            <include
                android:id="@+id/clockRow"
                layout="@layout/row_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
            <include
                android:id="@+id/healthRow"
                layout="@layout/row_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
            <include
                android:id="@+id/cleanRow"
                layout="@layout/row_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
            <include
                android:id="@+id/skipFavsRow"
                layout="@layout/row_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
            <include android:id="@+id/hiddenRow" layout="@layout/row_link" />
            <include android:id="@+id/rulesRow" layout="@layout/row_link" />
            <include android:id="@+id/androidRow" layout="@layout/row_link" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
