<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV boxes have no touchscreen and use the leanback launcher. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Weakest kill backend; a normal permission, granted at install time. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Re-arm the schedule after a reboot or a self-update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keep the CPU awake for the kill/relaunch window while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Exact alarms are what let the timer survive Doze. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to enumerate installed apps so the user can pick targets. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Shizuku's own permission gate, for its pre-v11 grant mechanism. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Holding this grants an exemption from background-activity-start limits,
         which is how a relaunch works while nothing of ours is on screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 127.0.0.1: the box's own network-debugging port, which is how Shizuku gets started without a
         computer. And, only when the viewer presses Get in Setup, Shizuku's APK from its GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installs Shizuku (and nothing else) after checking it is Rikka's signed build: ShizukuDownloader. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- To see whether a restarted VPN came back (VpnCheck). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets "Remove setup" offer the system's own uninstall dialog for Refresher. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Backup is off deliberately. The app keeps an ADB private key at
         filesDir/adb/adbkey which this box's own adbd trusts, and `adb backup`
         would hand it out. It also removes a restore path for tampered rules,
         whose package names reach a root shell in RootBackend. Nothing stored
         here is worth carrying across a reinstall anyway. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TasksKiller">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Refresh now": a second home-screen tile, and a target for remote
             button mappers, that refreshes every enabled rule without opening
             anything. The empty task affinity keeps Refresher's own task from
             coming forward, so whatever was on screen is still there after. -->
        <activity
            android:name=".ui.RefreshNowActivity"
            android:banner="@drawable/refresh_now_banner"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/refresh_now"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RuleEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false" />

        <!-- Refresher Home: a launcher. Android uses it as the home screen once it is the only (or chosen) one. -->

        <activity

            android:name=".ui.HomeActivity"

            android:exported="true"

            android:label="@string/home_label"

            android:launchMode="singleTask"

            android:stateNotNeeded="true"

            android:excludeFromRecents="true"

            android:clearTaskOnLaunch="true"

            android:resumeWhilePausing="true"

            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />

                <category android:name="android.intent.category.DEFAULT" />

            </intent-filter>

        </activity>


        <activity

            android:name=".ui.HomeSettingsActivity"

            android:exported="false" />


        <activity

            android:name=".ui.SystemActivity"

            android:exported="false" />


        <activity
            android:name=".ui.LogActivity"
            android:exported="false" />

        <!-- directBootAware so an alarm that lands before the first unlock can
             still be serviced; all state it touches lives in device-protected
             storage. -->
        <service
            android:name=".schedule.WakeWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for the display to turn on to restart user-selected apps" />
        </service>

        <service
            android:name=".schedule.RestartService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Scheduled restart of user-selected apps while the display is off" />
        </service>

        <receiver
            android:name=".schedule.RestartAlarmReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Starts Shizuku over network debugging shortly after a reboot. Not
             directBootAware: it needs the adb key in credential storage. -->
        <receiver
            android:name=".setup.ShizukuStartReceiver"
            android:exported="false" />

        <!-- Optional device-owner backend. Only active if the box was provisioned
             with `dpm set-device-owner`; harmless otherwise. -->
        <receiver
            android:name=".kill.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.HistorySampler"
            android:exported="false" />

        <receiver
            android:name=".setup.ShizukuInstallReceiver"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
