<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One flat, cool-neutral palette (the "Status first" design). Focus is
         always white: a focused row or button turns white with dark text, a
         focused card gets a white ring. -->
    <color name="background">#FF14171C</color>
    <color name="surface">#FF20242B</color>
    <color name="surface_raised">#FF2A2F37</color>
    <color name="hairline">#FF323843</color>
    <color name="hairline_strong">#40FFFFFF</color>

    <color name="text_primary">#FFECEFF3</color>
    <color name="text_secondary">#FFAEB5C0</color>
    <color name="text_tertiary">#FF7D8592</color>
    <color name="text_on_focus">#FF14171C</color>
    <color name="text_on_focus_secondary">#FF4A5260</color>
    <color name="focus">#FFFFFFFF</color>

    <!-- Status: each colour pairs with a dark tint for the badge behind it. -->
    <color name="ok">#FF7FD49A</color>
    <color name="ok_deep">#FF2F9E5B</color>
    <color name="ok_tint">#FF1D3326</color>
    <color name="warn">#FFF2B866</color>
    <color name="warn_tint">#FF3A2C18</color>
    <color name="bad">#FFF2837A</color>
    <color name="bad_deep">#FFC4483F</color>
    <color name="bad_tint">#FF3D1F1D</color>
    <color name="idle">#FF7D8592</color>
    <color name="idle_tint">#FF262A31</color>
    <!-- Home's backdrop before an app is focused: a soft slate blue. -->
    <color name="home_wash">#7039507A</color>
</resources>
