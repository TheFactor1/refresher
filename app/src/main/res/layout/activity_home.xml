<?xml version="1.0" encoding="utf-8"?>
<!-- Refresher Home: the launcher. Clock and date, the TV's health, Clean up, then favourites and every app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    style="@style/Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeClock"
                style="@style/Text.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/homeDate"
                style="@style/Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/healthChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/healthDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/idle" />

            <TextView
                android:id="@+id/healthText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textColor="@color/row_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cleanChip"
            style="@style/HomeChip"
            android:layout_marginEnd="8dp"
            android:text="@string/home_clean" />

        <TextView
            android:id="@+id/refresherChip"
            style="@style/HomeChip"
            android:layout_marginEnd="8dp"
            android:text="@string/home_refresher" />

        <TextView
            android:id="@+id/settingsChip"
            style="@style/HomeChip"
            android:text="@string/home_settings" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="-6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_l"
        android:scrollbars="none" />
</LinearLayout>
