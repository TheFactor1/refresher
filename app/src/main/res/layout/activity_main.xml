<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        style="@style/Screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The answer to "is it working?" -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/statusBadge"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_badge">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_status_ok" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headline"
                    style="@style/Text.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:accessibilityHeading="true" />

                <TextView
                    android:id="@+id/subline"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Always within reach, top right: what happened, and what Refresher needs. -->
            <LinearLayout
                android:id="@+id/navRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/space_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/systemButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_system"
                    android:textColor="@color/row_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/activityButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_activity"
                    android:textColor="@color/row_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/setupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/nav_setup"
                    android:textColor="@color/row_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- When something's wrong: the one button that fixes it. -->
        <LinearLayout
            android:id="@+id/fixRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="88dp"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fixButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/fixHint"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/appsHeader"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/apps_header"
            android:accessibilityHeading="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/needsHeader"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/needs_header"
            android:accessibilityHeading="true" />

        <!-- All checks on screen at once: one row of equal shares, each wrapping to two lines if it must. -->
        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <include
        android:id="@+id/restartCard"
        layout="@layout/view_restart_card" />
</FrameLayout>
