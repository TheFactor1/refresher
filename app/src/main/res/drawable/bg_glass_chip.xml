<?xml version="1.0" encoding="utf-8"?>
<!-- Home's pills and buttons: glass at rest, solid white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
