<?xml version="1.0" encoding="utf-8"?>
<!-- The dock's All apps button: a glass square that rings white when focused, like an app tile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
