<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/logTime"
        style="@style/Text.RowSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_m"
        android:fontFeatureSettings="tnum"
        android:textSize="15sp" />

    <View
        android:id="@+id/logDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_dot" />

    <TextView
        android:id="@+id/logText"
        style="@style/Text.RowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/logNote"
        style="@style/Text.RowSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:maxLines="1" />
</LinearLayout>
