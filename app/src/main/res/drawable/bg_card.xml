<?xml version="1.0" encoding="utf-8"?>
<!-- An app card: a white ring when focused, drawn inside the card's own bounds
     so focus never changes its size or its neighbours' positions. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/surface_raised" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
</selector>
