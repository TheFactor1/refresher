<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TasksKiller" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ok</item>
        <item name="colorSecondary">@color/ok</item>
        <item name="colorControlActivated">@color/ok</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.Refresher.Button</item>
    </style>

    <!-- Screen frame: the same gutters on every screen. -->
    <style name="Screen">
        <item name="android:paddingStart">@dimen/gutter_h</item>
        <item name="android:paddingEnd">@dimen/gutter_h</item>
        <item name="android:paddingTop">@dimen/gutter_top</item>
        <item name="android:paddingBottom">@dimen/gutter_bottom</item>
    </style>

    <!-- Type scale: 38 / 32 / 17 / 16 / 14 / 13 -->
    <style name="Text" />
    <style name="Text.Hero">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Crumb">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Sub">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Label">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:textColor">@color/row_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Text.RowSub">
        <item name="android:textColor">@color/row_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- A focusable row: white with dark text when focused. -->
    <style name="Row">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">@dimen/row_pad_h</item>
        <item name="android:paddingEnd">@dimen/row_pad_h</item>
        <item name="android:paddingTop">@dimen/row_pad_v</item>
        <item name="android:paddingBottom">@dimen/row_pad_v</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Buttons: pills that turn white when focused. -->
    <style name="Widget.Refresher.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Refresher.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/button_danger_text</item>
    </style>

    <style name="Widget.Refresher.Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- A Home header chip (same look as the home screen's Activity / Setup chips). -->
    <style name="HomeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/row_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
