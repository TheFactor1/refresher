<?xml version="1.0" encoding="utf-8"?>
<!-- "Restart now" progress: sits in the bottom corner and closes itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="@dimen/gutter_h"
    android:layout_marginBottom="@dimen/gutter_bottom"
    android:background="@drawable/bg_toast"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:visibility="gone"
    android:accessibilityLiveRegion="polite">

    <TextView
        android:id="@+id/restartTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_focus"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/restartSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_on_focus_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.25" />
</LinearLayout>
