<?xml version="1.0" encoding="utf-8"?>
<!-- A setting with a value: left and right step it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/rowHint"
            style="@style/Text.RowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowLess"
        style="@style/Text.RowSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:text="@string/step_less"
        android:textSize="22sp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/rowValue"
        style="@style/Text.RowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:minWidth="96dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rowMore"
        style="@style/Text.RowSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_more"
        android:textSize="22sp"
        android:importantForAccessibility="no" />
</LinearLayout>
